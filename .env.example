PORT=3100

# Paystack test keys (live keys work the same way)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Premium price, in kobo, for a 30-day period (500000 = ₦5,000)
# Free includes 1 upload; Premium includes 10 uploads per active 30 days.
PRICE_KOBO=500000

# Supabase project (server only — never expose the service role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=studyflow-uploads

# Google Gemini (AI study pack generation)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Supabase Auth (browser-exposed; the anon key is safe with RLS)
# Use the same project URL as SUPABASE_URL and the anon public key. These are
# embedded at build time when present and exposed via /api/config at runtime.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
