{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "server.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|robots.txt|favicon.svg|index.html).*)",
      "destination": "/index.html"
    }
  ]
}
